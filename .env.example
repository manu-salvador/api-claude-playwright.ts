# Copy this file to `.env` (shared) or `.env.int` / `.env.uat` (per environment).
# All .env* files except this one are git-ignored.
# Get your token at https://gorest.co.in/consumer/login

# Bearer token used for POST / PUT / PATCH / DELETE requests
GOREST_TOKEN=

# Optional: override the base URL defined in src/config/environments.ts
# BASE_URL=https://gorest.co.in/public/v2

# Optional: request timeout in ms
# REQUEST_TIMEOUT=15000
